FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}

phaseTurbulenceStabilisationAir
{
    type    phaseTurbulenceStabilisation;

    libs    ("libmultiphaseEulerFvModels.so");

    phase   air;

    alphaInversion  0.1;
}

phaseTurbulenceStabilisationWater
{
    type    phaseTurbulenceStabilisation;

    libs    ("libmultiphaseEulerFvModels.so");

    phase   water;

    alphaInversion  0.1;
}

porosity
{
    type            porosityForce;

    porosityForceCoeffs
    {
        cellZone        cylinder;

        type            DarcyForchheimer;

        D   1e8;

        d   ($D $D $D);
        f   (0 0 0);

        UNames  (U.water U.air);

        coordinateSystem
        {
            type    cartesian;
            origin  (0 0 0);
            coordinateRotation
            {
                type    axesRotation;
                e1  (1 0 0);
                e2  (0 1 0);
            }
        }
    }
}
