FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties.water;
}

simulationType  RAS;
//simulationType  LES;

LES
{
    model    NicenoKEqn;

    turbulence      on;
    printCoeffs     on;

    delta           cubeRootVol;

    cubeRootVolCoeffs
    {
    }
}

RAS
{
    model       kOmegaSSTSato;

    turbulence  on;
    printCoeffs on;
}
