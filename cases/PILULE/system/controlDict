FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     multiphaseEulerFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         20;

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   0.2;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.4;

maxDeltaT       1;

libs
(
    "libLogMoM.so"
);

functions
{
    #includeFunc fieldAverage(U.air, U.water, alpha.air, p, A.air, N.air, d.air, sigma.air, k.water, nut.water, omega.water, NCoaRate.air, ACoaRate.air, NBreakRate.air, ABreakRate.air)

    forceAir
    {
        type            forces;
        libs            ("libforces.so");
        log             true;
        patches         (wall_cylinder);
        CofR            (0 0 1.02);
        p               p;
        U               U.air;
        rho             thermo:rho.air;
        phase           air;
    }

    forceWater
    {
        type            forces;
        libs            ("libforces.so");
        log             true;
        patches         (wall_cylinder);
        CofR            (0 0 1.02);
        p               p;
        U               U.water;
        rho             thermo:rho.water;
        phase           water;
    }
}
