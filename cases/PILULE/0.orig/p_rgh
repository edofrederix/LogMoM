FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions          [1 -1 -2 0 0 0 0];

internalField       uniform 1.2e5;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
    }

    outlet
    {
        type            prghPressure;
        value           $internalField;
        p               $internalField;
    }

    "wall.*"
    {
        type            fixedFluxPressure;
    }

    symm
    {
        type            symmetry;
    }
}
