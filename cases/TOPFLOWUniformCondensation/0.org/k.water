FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k.water;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    empties
    {
        type            empty;
    }
}

sources
{
    phaseChange
    {
        type            uniformFixedValue;
        uniformValue    $internalField;
    }
}
