FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application         foamRun;

solver              multiphaseEuler;

startFrom           latestTime;

startTime           0;

stopAt              endTime;

endTime             4;

deltaT              1e-4;

writeControl        adjustableRunTime;

writeInterval       0.1;

purgeWrite          0;

writeFormat         ascii;

writePrecision      6;

writeCompression    uncompressed;

timeFormat          general;

timePrecision       6;

runTimeModifiable   yes;

adjustTimeStep      yes;

maxCo               0.4;

maxDeltaT           1;

libs
(
    "libLogMoM.so"
);

functions
{
    #includeFunc    residuals(p_rgh, k.water, omega.water)

    #includeFunc    graphUniform
    (
        funcName=graph,
        start=(0 0 0.89),
        end=(0.025 0 0.89),
        nPoints=100,
        fields=
        (
            d.air
            dcm.air
            sigma.air
            alpha.air
            U.air
        )
    )

    #includeFunc    writeObjects(d.air)
    #includeFunc    writeObjects(sigma.air)
}
