// Inlet moment fluxes [m^gamma/s]

inletPhiN
{
    type            surfaceFieldValue;
    patch           inlet;
    fields          (N.air);
    operation       sum;
    weightField     phi.air;
    writeControl    writeTime;
    writeFields     false;
}

inletPhiA
{
    type            surfaceFieldValue;
    patch           inlet;
    fields          (A.air);
    operation       sum;
    weightField     phi.air;
    writeControl    writeTime;
    writeFields     false;
}

inletPhiAlpha
{
    type            surfaceFieldValue;
    patch           inlet;
    fields          (alpha.air);
    operation       sum;
    weightField     phi.air;
    writeControl    writeTime;
    writeFields     false;
}

// Outlet moment fluxes [m^gamma/s]

outletPhiN
{
    type            surfaceFieldValue;
    patch           outlet;
    fields          (N.air);
    operation       sum;
    weightField     phi.air;
    writeControl    writeTime;
    writeFields     false;
}

outletPhiA
{
    type            surfaceFieldValue;
    patch           outlet;
    fields          (A.air);
    operation       sum;
    weightField     phi.air;
    writeControl    writeTime;
    writeFields     false;
