// Inlet fluxes [m^3/s]

inletPhi
{
    type            surfaceFieldValue;
    patch           inlet;
    fields          (phi.air phi.air phi.air);
    operation       sum;
    writeControl    writeTime;
    writeFields     false;
}

// Outlet fluxes [m^3/s]

outletPhi
{
    type            surfaceFieldValue;
    patch           outlet;
    fields          (phi.air phi.air phi.air);
    operation       sum;
    writeControl    writeTime;
    writeFields     false;
}

